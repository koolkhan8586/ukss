# Public site URL (nginx vhost)
APP_URL=https://exp.ukssolution.com
PORT=3007
NODE_ENV=production

# JWT_SECRET = a long random password used to sign login tokens
# (so the API can trust that a logged-in user is really that user).
# Generate one with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# MySQL on this Contabo server (create these first — see deploy/README.md)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ukss_expense
DB_USER=ukss_expense
DB_PASSWORD=UkssExp@2026!Db

# Bootstrap admin (created on first migrate if users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Portal Admin
