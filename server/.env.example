# Public site URL (nginx vhost)
APP_URL=https://exp.ukssolution.com
PORT=3000
NODE_ENV=production

# JWT secret used to sign mobile/web login tokens
JWT_SECRET=change-me-to-a-long-random-string

# MySQL / MariaDB on your Contabo / aaPanel server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ukss_expense
DB_USER=ukss_expense
DB_PASSWORD=your_database_password

# Optional bootstrap admin (created on migrate if users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Portal Admin
