# Public site URL (nginx vhost)
APP_URL=https://exp.ukssolution.com
PORT=3007
NODE_ENV=production

# JWT_SECRET = a long random password used to sign login tokens
# Generate one with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# MySQL on this Contabo server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ukss_expense
DB_USER=ukss_expense
DB_PASSWORD=UkssExp@2026!Db

# Bootstrap admin (created on migrate if users table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Portal Admin

# WhatsApp via WAHA (https://waha.devlike.pro)
# Example if WAHA runs on same Contabo box: http://127.0.0.1:3000
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=
WAHA_SESSION=default
# Admin WhatsApp for new expense / duty alerts (e.g. 923001234567)
ADMIN_WHATSAPP=
